{
  "expo": {
    "name": "Merror",
    "slug": "merror",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "merror",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAF9",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.merror.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.merror.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Merror to access your camera to scan QR codes."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyUrl": "https://merror.vercel.app/en/privacy",
      "supportUrl": "https://merror.vercel.app/en/support"
    }
  }
}
