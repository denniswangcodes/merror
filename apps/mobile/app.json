{
  "expo": {
    "name": "Merror",
    "slug": "merror",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "merror",
    "userInterfaceStyle": "light",
    "backgroundColor": "#18181F",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.merrorios.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.merror.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#18181F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#18181F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Merror to access your camera to scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Merror to access your photos so you can add one to your profile or a reflection.",
          "cameraPermission": "Allow Merror to use your camera to take a photo for your profile or a reflection."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyUrl": "https://merror.vercel.app/en/privacy",
      "supportUrl": "https://merror.vercel.app/en/support",
      "router": {},
      "eas": {
        "projectId": "595aa4fa-90b2-4a45-a9e5-f36e404db30a"
      }
    },
    "owner": "denniswangexpo"
  }
}
