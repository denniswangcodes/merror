// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FeedbackType {
  COMPLIMENT
  HELPFUL_ACT
  MEMORY
  ENCOURAGEMENT
  COMMUNITY_SERVICE
  ENVIRONMENTAL_ACT
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FEEDBACK_RECEIVED
  FEEDBACK_APPROVED
  FEEDBACK_REJECTED
  FEEDBACK_LIKED
  FEEDBACK_COMMENTED
}

enum ReportReason {
  HARASSMENT
  HATE_SPEECH
  SEXUAL_CONTENT
  VIOLENCE
  SPAM
  IMPERSONATION
  PRIVACY
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  displayName       String?
  username          String    @unique
  avatarUrl         String?
  bio               String?
  qrCode            String    @unique @default(cuid())
  role              Role      @default(USER)
  preferredLanguage String    @default("en")
  totalPoints       Int       @default(0)
  suspendedAt       DateTime?
  lastActiveAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())

  feedbackReceived  Feedback[]     @relation("Receiver")
  feedbackGiven     Feedback[]     @relation("Giver")
  friends           Friendship[]   @relation("UserA")
  friendOf          Friendship[]   @relation("UserB")
  notifications     Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationSender")
  reportsFiled      Report[]       @relation("ReportReporter")
  reportsAgainst    Report[]       @relation("ReportUser")
  blocksInitiated   Block[]        @relation("Blocker")
  blocksReceived    Block[]        @relation("Blocked")
  likes             Like[]
  comments          Comment[]

  @@index([lastActiveAt])
}

model Feedback {
  id            String         @id @default(cuid())
  giverId       String
  receiverId    String?
  recipientName String?
  type          FeedbackType
  message       String
  imageUrl      String?
  points        Int            @default(1)
  isPublic      Boolean        @default(true)
  status        FeedbackStatus @default(APPROVED)
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())

  giver    User      @relation("Giver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver User?     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  reports  Report[]
  likes    Like[]
  comments Comment[]
}

model Like {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@index([feedbackId])
}

model Comment {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  message    String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
}

model Friendship {
  id        String       @id @default(cuid())
  userAId   String
  userBId   String
  status    FriendStatus @default(PENDING)
  createdAt DateTime     @default(now())

  userA User @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  fromUserId  String?
  referenceId String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user     User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User? @relation("NotificationSender", fields: [fromUserId], references: [id], onDelete: SetNull)
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  feedbackId     String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  moderatorNote  String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  reporter     User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?     @relation("ReportUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  feedback     Feedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([feedbackId])
}
